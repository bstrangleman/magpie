{
  "manifest_version": 3,
  "name": "Magpie",
  "description": "Save pages, links, images and notes to your self-hosted Magpie bookmark manager.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Save to Magpie",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Save the current page to Magpie"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "magpie-extension@magpie.app",
      "strict_min_version": "128.0"
    }
  }
}
